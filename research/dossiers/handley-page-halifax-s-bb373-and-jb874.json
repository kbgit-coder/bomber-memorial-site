      "tier": "researched",
      "retrieved": "2026-10-28",
      "summary": "Entry for the plaque at Hull Bridge. Lists the 14 dead and Sgt J. Greet as survivor. No county, builder, dedication date or custodian given; custodian field open for claiming.",
      "key_details": [
        "WMO 229912",
        "custodian: Information Required"
      ]
    },
